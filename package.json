{
  "name": "circuit-bored",
  "private": true,
  "version": "0.0.1",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "dev:visual": "vite --open /visual-lab.html",
    "build": "tsc && vite build",
    "preview": "vite preview",
    "preview:visual": "vite preview --open /visual-lab.html",
    "test": "vitest run",
    "test:watch": "vitest",
    "typecheck": "tsc --noEmit",
    "check": "npm run typecheck && npm test && npm run build",
    "check:visual": "vitest run tests/render.test.ts tests/visual-lab.test.ts tests/visual-pipeline.test.ts",
    "visual:review": "node tools/visual-review.mjs review",
    "visual:capture": "node tools/visual-review.mjs capture",
    "visual:baseline": "node tools/visual-review.mjs baseline",
    "visual:compare": "node tools/visual-review.mjs compare",
    "visual:sample": "node tools/visual-review.mjs sample"
  },
  "devDependencies": {
    "@types/node": "^26.2.0",
    "@types/pngjs": "^6.0.5",
    "pixelmatch": "^7.2.0",
    "playwright": "^1.62.1",
    "pngjs": "^7.0.0",
    "typescript": "^5.6.0",
    "vite": "^8.2.1",
    "vitest": "^4.1.10"
  }
}
